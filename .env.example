# Copy to `.env.local` for a new local setup and fill in only what you need.
# This file is reference documentation; upgrading the app does NOT require
# replacing or regenerating an existing `.env.local`. The app starts without
# these values and degrades as noted, though SITE_PASSWORD and DATABASE_URL are
# effectively required for a usable deployed application.

# --- Pre-launch gate --------------------------------------------------------
# Shared password protecting the whole site (see src/proxy.ts). REQUIRED in any
# deployed environment: when unset the gate fails closed and every request is
# redirected to /splash, so the app is unusable.
SITE_PASSWORD=

# Set to exactly "true" to go live: see LAUNCH.md and isPublicLaunch() in
# src/lib/gate.ts. Unsetting SITE_PASSWORD alone does NOT open the site —
# the gate fails closed — this is the deliberate, separate switch that both
# lifts the gate and turns on search-engine indexing. Leave unset/false in
# every environment except the real public launch.
SITE_PUBLIC=

# --- Persistence ------------------------------------------------------------
# Postgres connection string. When unset, report runs are not logged and the
# email capture form is hidden; the report itself still works.
DATABASE_URL=

# --- Seed accounts ----------------------------------------------------------
# Optional. On startup (see src/instrumentation.ts) each fully-specified pair is
# created — or re-synced — as a login account, so you don't have to sign up by
# hand. Requires DATABASE_URL. Idempotent: change a password here and redeploy
# to reset it. A pair is skipped unless BOTH halves are set.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Transactional email -----------------------------------------------------
# Sends password-reset emails via Resend's HTTP API (src/lib/email.ts). Without
# it, reset links are never emailed -- they're logged server-side instead
# (event "password_reset.link_not_emailed"), so resets still work for whoever
# can read the logs, but no email goes to the user. EMAIL_FROM defaults to
# "WeBind <no-reply@webind.design>" if unset.
RESEND_API_KEY=
EMAIL_FROM=

# Fallback absolute origin for links baked into emails (src/lib/baseUrl.ts).
# Normally derived from the request's forwarded host/proto, so this is only used
# when no request context is available; defaults to http://localhost:3000.
APP_BASE_URL=

# --- Scheduled cleanup --------------------------------------------------------
# Bearer token protecting POST /api/cron/cleanup-sessions (deletes expired
# session rows). Point an external scheduler (Railway Cron, a GitHub Actions
# schedule, cron-job.org, ...) at that endpoint with
# `Authorization: Bearer <this value>`, e.g. daily. Without this set, the
# endpoint refuses every request (fails closed) -- expired sessions still get
# swept eventually via a small probabilistic chance on each new login, just
# less thoroughly.
CRON_SECRET=

# --- WordPress one-click apply (Phase 2) ------------------------------------
# 32-byte key encrypting a connected site's Application Password at rest.
# Generate with `openssl rand -base64 32`. Required to connect a WordPress
# site; without it, "Connect" in Settings is refused rather than storing the
# secret unencrypted. Rotating this key invalidates every stored connection
# (each user would need to reconnect).
CREDENTIALS_KEY=

# --- AI ---------------------------------------------------------------------
# Claude: report summaries plus the implemented Claude citation/visibility
# probes. It is NOT automatically reused by the new tuning pipeline; Claude is
# used as the synthetic judge only when TUNING_JUDGE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Gemini Developer API: implemented Gemini visibility probes, Content Studio's
# pinned planner (BASE_GEMINI_MODEL, currently gemini-3.6-flash), base writer
# fallback, and the default synthetic teacher/judge. Existing GEMINI_API_KEY
# deployments need no new key for those base-model paths.
GEMINI_API_KEY=

# These answer-engine integrations are still intentional stubs. A present key
# makes the engine visible as configured, but a probe fails safe to "unknown"
# until its provider is implemented; leave unset unless developing that adapter.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
SERPAPI_API_KEY=

# Existing generic Fix Generator controls. These do NOT change the Content
# Studio planner, synthetic teacher, or base writer fallback, which are pinned
# to BASE_GEMINI_MODEL (currently gemini-3.6-flash) at MEDIUM thinking for
# compatibility with the content architecture.
FIX_GENERATOR_PROVIDER=gemini
GEMINI_GENERATOR_MODEL=
GEMINI_THINKING_LEVEL=
ANTHROPIC_GENERATOR_MODEL=

# Keyword Visibility can use a separate Gemini model id if deliberately tested;
# otherwise its implemented Gemini provider uses BASE_GEMINI_MODEL.
GEMINI_VISIBILITY_MODEL=

# Offline synthetic-corpus judge. Default is the base Gemini model so merely
# having an existing ANTHROPIC_API_KEY cannot silently add Claude calls/cost.
# Set to `anthropic` only when deliberately running the cross-vendor judge.
TUNING_JUDGE_PROVIDER=gemini

# Tuned Content Studio writer (optional future promotion).
#
# IMPORTANT: this is deliberately NOT authenticated with GEMINI_API_KEY.
# A supervised-tuned model is hosted behind a Vertex AI endpoint and therefore
# uses Google Cloud auth. After the tuning job succeeds, copy the exact
# `tunedModel.endpoint` resource name here, e.g.:
# projects/my-project/locations/us-central1/endpoints/123456789012345
#
# The server/host must also have Vertex Application Default Credentials, for
# example via workload identity, an attached service account, or:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# None of these variables is needed until a tuned endpoint is deliberately
# promoted. If absent or if the Vertex call fails, Content Studio uses the
# existing GEMINI_API_KEY-backed 3.7 writer before its deterministic fallback.
CONTENT_WRITER_VERTEX_ENDPOINT=
CONTENT_WRITER_THINKING_LEVEL=MINIMAL
GOOGLE_APPLICATION_CREDENTIALS=

# Competitive benchmarking: organic top-10 / near-miss cohort via serper.dev.
# This is implemented in src/lib/benchmark/serper.ts. Distinct vendor from
# SERPAPI_API_KEY above — do not reuse that key in this slot.
SERPER_API_KEY=

# Core Web Vitals field data: a plain Google Cloud API key with the PageSpeed
# Insights API enabled. Public CrUX data — no OAuth. When unavailable or the URL
# has no field-data coverage, the Page Experience enrichment is omitted.
PSI_API_KEY=

# How many times each engine is probed per keyword. AI answers are stochastic,
# so >1 turns a coin-flip yes/no into a citation rate with a credible interval.
# Default 1 (single probe, unchanged cost); capped at 5. Higher = more API cost.
VISIBILITY_SAMPLES=1

# --- Crawler admission control ----------------------------------------------
# Concurrent crawls, and how many may queue behind them before requests are
# refused with a "try again shortly" message. Each concurrent crawl holds a
# browser context; raise only alongside container memory.
CRAWL_CONCURRENCY=3
CRAWL_QUEUE_DEPTH=12

# How the crawler identifies itself on the wire. Defaults to a branded token
# with a contact URL; override when deploying under a different domain so site
# operators can recognize and allow/deny this analyzer in their robots.txt.
CRAWLER_USER_AGENT=

# --- Billing (Stripe) -------------------------------------------------------
# All optional. With none set, the pricing page still renders and the free plan
# works; paid CTAs simply can't open checkout (they degrade to "start free").
# STRIPE_SECRET_KEY enables checkout + the webhook; STRIPE_WEBHOOK_SECRET is the
# signing secret Stripe shows when you register the /api/billing/webhook
# endpoint (required to accept webhooks — unsigned/invalid payloads are
# rejected). STRIPE_PRICE_* are the recurring Price ids for each paid plan.
#
# SANDBOX (test mode): use TEST-mode values — secret key `sk_test_...`, Price
# ids created while Stripe's "Test mode" toggle is on, and the signing secret
# from a test webhook (or `stripe listen` locally). The app auto-detects test
# vs live from the key prefix and shows a "Sandbox" badge; anything not clearly
# `sk_live_`/`rk_live_` is treated as test. Test card: 4242 4242 4242 4242.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
