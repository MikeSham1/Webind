# Copy to `.env.local` and fill in. The app starts without any of these and
# degrades as noted, so all are optional for local dev — but a couple are
# effectively required for a usable deployment (SITE_PASSWORD, DATABASE_URL);
# see their notes below.

# --- Pre-launch gate --------------------------------------------------------
# Shared password protecting the whole site (see src/proxy.ts). REQUIRED in any
# deployed environment: when unset the gate fails closed and every request is
# redirected to /splash, so the app is unusable.
SITE_PASSWORD=

# --- Persistence ------------------------------------------------------------
# Postgres connection string. When unset, report runs are not logged and the
# email capture form is hidden; the report itself still works.
DATABASE_URL=

# --- Seed accounts ----------------------------------------------------------
# Optional. On startup (see src/instrumentation.ts) each fully-specified pair is
# created — or re-synced — as a login account, so you don't have to sign up by
# hand. Requires DATABASE_URL. Idempotent: change a password here and redeploy
# to reset it. A pair is skipped unless BOTH halves are set.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Transactional email -----------------------------------------------------
# Sends password-reset emails via Resend's HTTP API (src/lib/email.ts). Without
# it, reset links are never emailed -- they're logged server-side instead
# (event "password_reset.link_not_emailed"), so resets still work for whoever
# can read the logs, but no email goes to the user. EMAIL_FROM defaults to
# "WeBind <no-reply@webind.design>" if unset.
RESEND_API_KEY=
EMAIL_FROM=

# Fallback absolute origin for links baked into emails (src/lib/baseUrl.ts).
# Normally derived from the request's forwarded host/proto, so this is only used
# when no request context is available; defaults to http://localhost:3000.
APP_BASE_URL=

# --- Scheduled cleanup --------------------------------------------------------
# Bearer token protecting POST /api/cron/cleanup-sessions (deletes expired
# session rows). Point an external scheduler (Railway Cron, a GitHub Actions
# schedule, cron-job.org, ...) at that endpoint with
# `Authorization: Bearer <this value>`, e.g. daily. Without this set, the
# endpoint refuses every request (fails closed) -- expired sessions still get
# swept eventually via a small probabilistic chance on each new login, just
# less thoroughly.
CRON_SECRET=

# --- WordPress one-click apply (Phase 2) ------------------------------------
# 32-byte key encrypting a connected site's Application Password at rest.
# Generate with `openssl rand -base64 32`. Required to connect a WordPress
# site; without it, "Connect" in Settings is refused rather than storing the
# secret unencrypted. Rotating this key invalidates every stored connection
# (each user would need to reconnect).
CREDENTIALS_KEY=

# --- AI ---------------------------------------------------------------------
# Enables Claude-written report summaries. Without it, a deterministic
# network-free narrative is used instead.
ANTHROPIC_API_KEY=

# Answer-engine keys for live citation and keyword-visibility checks
# (src/lib/scoring/ai-citations.ts and src/lib/visibility/). The Claude provider
# uses ANTHROPIC_API_KEY above and is fully implemented. The rest are stubs:
# setting a key makes that engine report as configured and then fail safe to
# "unknown", so leave them empty until the providers are implemented.
# GEMINI_API_KEY covers Google's Gemini; SERPAPI_API_KEY is for Google organic /
# AI Overviews via a third-party SERP API.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=

# --- Crawler admission control ----------------------------------------------
# Concurrent crawls, and how many may queue behind them before requests are
# refused with a "try again shortly" message. Each concurrent crawl holds a
# browser context; raise only alongside container memory.
CRAWL_CONCURRENCY=3
CRAWL_QUEUE_DEPTH=12

# How the crawler identifies itself on the wire. Defaults to a branded token
# with a contact URL; override when deploying under a different domain so site
# operators can recognize and allow/deny this analyzer in their robots.txt.
CRAWLER_USER_AGENT=

# --- Billing (Stripe) -------------------------------------------------------
# All optional. With none set, the pricing page still renders and the free plan
# works; paid CTAs simply can't open checkout (they degrade to "start free").
# STRIPE_SECRET_KEY enables checkout + the webhook; STRIPE_WEBHOOK_SECRET is the
# signing secret Stripe shows when you register the /api/billing/webhook
# endpoint (required to accept webhooks — unsigned/invalid payloads are
# rejected). STRIPE_PRICE_* are the recurring Price ids for each paid plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
